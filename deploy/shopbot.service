[Unit]
Description=Valorant Shop Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/valorant-shop-bot
EnvironmentFile=/home/ubuntu/valorant-shop-bot/config.env
ExecStartPre=-/usr/bin/git -C /home/ubuntu/valorant-shop-bot pull
ExecStartPre=-/usr/bin/pip3 install -q -r /home/ubuntu/valorant-shop-bot/requirements.txt
ExecStart=/usr/bin/python3 -u bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
